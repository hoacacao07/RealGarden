DEMO_MODE=true
DB_POOL_MAX=              # 1 for the local `npm run db:local` server; empty = 5
DATABASE_URL=            # Supabase pooled connection (port 6543, ?pgbouncer=true)
DIRECT_URL=              # Supabase direct connection (port 5432), used by Prisma migrate
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=     # optional: Supabase Realtime for the alert banner (falls back to polling)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never sent to the browser
CRON_SECRET=              # protects /api/cron/check-alerts (Authorization: Bearer ...)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # Web Push: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team-email@example.com
DEMO_RESET_TOKEN=        # protects /api/demo/reset
NWS_USER_AGENT=RealGarden demo (team-email@example.com)
PLANTNET_API_KEY=
PLANTNET_PROJECT=all
PP_KEY_ID=                # Permapeople, only for scripts/import-permapeople.ts (offline)
PP_KEY_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=            # latest stable Flash model from AI Studio (chat, vision, suggestions). Never hardcoded.
GEMINI_MODEL_LITE=       # stable Flash-Lite model (short rewrites, task text). Empty = use GEMINI_MODEL
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=1000
